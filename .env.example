# Copy this file to .env and fill in your keys. Never commit .env.

# Required: used for the generation stage (Claude).
ANTHROPIC_API_KEY=

# Optional: only needed when EMBEDDER=voyage (install with: pip install -e ".[voyage]").
VOYAGE_API_KEY=

# Optional: which embedder to use by default, "local" or "voyage".
# EMBEDDER=local
