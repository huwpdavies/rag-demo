# Copy this file to .env and fill in your key. Never commit .env.

# Required: used for the generation stage (Claude).
ANTHROPIC_API_KEY=

# Optional: the embedding model. Defaults to all-MiniLM-L6-v2, downloaded from
# huggingface.co on first use. If that site is blocked on your network, download
# the model folder elsewhere and point this at it.
# EMBED_MODEL=C:\path\to\all-MiniLM-L6-v2
